# WORKED EXAMPLE (see hosting/examples/README.md): first part of a dev-preview
# domain's root .htaccess (the router block, hosting/router.htaccess, follows
# it); assembled by an instantiation's own dev-root script (modelled on
# scripts/examples/dev-root.sh), deployed by CI, never in prd. Fill in
# {{SITE_BASE_HOST}} and {{VENDORED_HOST}} (bare hostnames) before use.
# This overlay previews two production hosts on one dev domain: the
# Vocabulary Hub UI (https://{{VENDORED_HOST}}/) at its root, and the
# vocabularies of both hosts (https://{{SITE_BASE_HOST}}/<asset-type>/<slug>/
# for the primary content host's own vocabularies,
# https://{{VENDORED_HOST}}/<asset-type>/<slug>/ for vendored standards)
# under their production paths. It is not a
# publication: keep it out of search results and name the production twin of
# every response as canonical, including responses served from subdirectories.

# No directory listings (OVH enables them by default).
Options -Indexes

RewriteEngine On
# Subdirectory .htaccess files (one per vocabulary slug) carry their own
# rewrite rules; without this they would silently drop the rules below.
RewriteOptions InheritDownBefore

# OVH web hosting: the port the client used is visible as SERVER_PORT.
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# The canonical path is the one in the client's own request line: unlike
# REQUEST_URI it survives every internal redirect (the router to voc/, content
# negotiation to a .ttl/.jsonld/.html, the directory index), so it is simply
# re-read on each pass. Its host is the one that serves that path in prd:
# {{VENDORED_HOST}} (the Hub UI) unless a vocabulary's own slug .htaccess,
# whose rules run after these, names its host ({{SITE_BASE_HOST}} for the
# primary content host's own vocabularies, {{VENDORED_HOST}} for vendored
# standards).
RewriteCond %{THE_REQUEST} ^\S+\s(/[^?\s]*)
RewriteRule ^ - [E=CANONICAL_PATH:%1,E=CANONICAL_HOST:{{VENDORED_HOST}}]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Link "<https://%{CANONICAL_HOST}e%{CANONICAL_PATH}e>; rel=\"canonical\"" env=CANONICAL_PATH
</IfModule>
