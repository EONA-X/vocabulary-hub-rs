# BEGIN eona-x vocabulary hub
# Part of the web root's .htaccess in each environment:
#   prd  eona-x.eu          installed once, by hand, at the TOP of
#                           <WP_ROOT>/.htaccess, above "# BEGIN WordPress"
#                           (WordPress rewrites its own block, never this one)
#   dev  dev-voc.eona-x.eu  after hosting/dev/.htaccess, deployed by CI
#                           (scripts/dev-root.sh, deploy:dev)
# Published IRIs are /<asset-type>/<slug>/<version>, <asset-type> one of
# ontology, shape, crosswalk, vocabulary, codelist (the build's ASSET_TYPES).
# Their files are deployed to voc/<asset-type>/<slug>/; this maps the published
# paths onto them. Every other path still reaches the site
# around it (WordPress in prd, the Vocabulary Hub UI dev build in dev), which
# must therefore never use one of those five names as a top-level path.
<IfModule mod_rewrite.c>
RewriteEngine On
# voc/ is not a public path (each voc/<asset-type>/<slug>/.htaccess guards
# its own subtree; this covers voc/ and voc/<asset-type>/).
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^voc(/.*)?$ - [R=404,L]
# /<asset-type>/: no index page (yet).
RewriteRule ^(ontology|shape|crosswalk|vocabulary|codelist)/?$ - [R=404,L]
# /<asset-type>/<slug> -> /<asset-type>/<slug>/ here, before mod_dir would
# redirect to /voc/<asset-type>/<slug>/. Absolute, on the request's own host:
# with a relative target Apache builds the URL, and behind OVH's TLS front it
# adds ":443".
RewriteRule ^((ontology|shape|crosswalk|vocabulary|codelist)/[^/]+)$ https://%{HTTP_HOST}/$1/ [R=301,L]
RewriteRule ^((ontology|shape|crosswalk|vocabulary|codelist)/.+)$ voc/$1 [L]
# An asset-type path with nothing behind it in voc/ (a slug of the other host,
# a typo) is a 404 of its own, not the surrounding site's page. A slug that
# exists answers from its own .htaccess and never comes back here.
RewriteCond %{ENV:REDIRECT_STATUS} !^$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^voc/ - [R=404,L]
</IfModule>
# END eona-x vocabulary hub
