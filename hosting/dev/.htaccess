# Root .htaccess of a dev-*.eona-x.eu host (dev-voc, dev-www) — deployed with
# the site by CI, never to eona-x.eu. A dev host is a preview, not the
# publication: keep it out of search results and name its eona-x.eu twin as
# canonical on every response, including the ones served from subdirectories.

RewriteEngine On
# Subdirectory .htaccess files (one per vocabulary slug) carry their own
# rewrite rules; without this they would silently drop the rules below.
RewriteOptions InheritDownBefore

# OVH web hosting: the port the client used is visible as SERVER_PORT.
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Remember the path the client asked for before content negotiation serves
# it from another file; after that internal redirect Apache exposes it as
# REDIRECT_CANONICAL_PATH.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^ - [E=CANONICAL_PATH:%{REQUEST_URI}]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Link "<https://eona-x.eu%{CANONICAL_PATH}e>; rel=\"canonical\"" env=CANONICAL_PATH
  Header always set Link "<https://eona-x.eu%{REDIRECT_CANONICAL_PATH}e>; rel=\"canonical\"" env=REDIRECT_CANONICAL_PATH
</IfModule>
