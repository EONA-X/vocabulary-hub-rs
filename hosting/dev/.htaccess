# First part of dev-voc.eona-x.eu's root .htaccess (the router block,
# hosting/router.htaccess, follows it); installed by hand, never on eona-x.eu.
# dev-voc mirrors eona-x.eu's paths for both the site and the vocabularies, so
# it is a preview, not the publication: keep it out of search results and name
# its eona-x.eu twin as canonical on every response, including the ones served
# from subdirectories.

RewriteEngine On
# Subdirectory .htaccess files (one per vocabulary slug) carry their own
# rewrite rules; without this they would silently drop the rules below.
RewriteOptions InheritDownBefore

# OVH web hosting: the port the client used is visible as SERVER_PORT.
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# The canonical path is the one in the client's own request line: unlike
# REQUEST_URI it survives every internal redirect (the router to voc/, content
# negotiation to a .ttl/.jsonld/.html, the directory index), so it is simply
# re-read on each pass.
RewriteCond %{THE_REQUEST} ^\S+\s(/[^?\s]*)
RewriteRule ^ - [E=CANONICAL_PATH:%1]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Link "<https://eona-x.eu%{CANONICAL_PATH}e>; rel=\"canonical\"" env=CANONICAL_PATH
</IfModule>
